<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (dataExtractionRules): gleiche Ausnahmen fuer Cloud-Backup und Geraete-Transfer.
     allowBackup=false schaltet das Cloud-Backup ab, bei manchen Herstellern aber NICHT den
     Geraeteumzug (Device-to-Device; Android-Doku zu targetSdk 31+:
     https://developer.android.com/about/versions/12/behavior-changes-12). Die Ausschluesse unter
     device-transfer sind deshalb tragend, keine blosse Absicherung: jede neue App-Datei mit
     Keys oder persoenlichen Daten gehoert in beide Listen und in backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="whisperloom.xml" />
        <exclude domain="sharedpref" path="whisperloom_agent.xml" />
        <exclude domain="file" path="models" />
        <exclude domain="file" path="voice_task.pcm" />
        <exclude domain="sharedpref" path="whisperloom_widgets.xml" />
        <exclude domain="sharedpref" path="whisperloom_models.xml" />
        <exclude domain="file" path="widget_icons" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="whisperloom.xml" />
        <exclude domain="sharedpref" path="whisperloom_agent.xml" />
        <exclude domain="file" path="models" />
        <exclude domain="file" path="voice_task.pcm" />
        <exclude domain="sharedpref" path="whisperloom_widgets.xml" />
        <exclude domain="sharedpref" path="whisperloom_models.xml" />
        <exclude domain="file" path="widget_icons" />
    </device-transfer>
</data-extraction-rules>
