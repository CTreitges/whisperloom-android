<?xml version="1.0" encoding="utf-8"?>
<!-- Vorschau des Sprach-Command-Widgets in der Widget-Auswahl (previewLayout statt previewImage).
     Zeigt die Standardgroesse 2x2 so, wie sie nach dem Platzieren aussieht: Variante STACK
     (widget_task.xml) mit dem Standardprofil im Zustand "bereit", Name unter der Kachel.
     Eigene Ids, damit die Vorschau nie mit dem echten Widget verwechselt wird. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_preview_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/widget_preview_tile"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="6dp"
        android:background="@drawable/widget_bg_ready">

        <ImageView
            android:id="@+id/widget_preview_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_mic"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/widget_preview_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="12sp"
            android:textColor="@color/loom_onSurfaceVariant"
            android:text="@string/widget_ready" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_preview_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="12sp"
        android:textColor="@color/loom_onSurface"
        android:shadowColor="@color/loom_labelShadow"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:text="@string/widget_label" />
</LinearLayout>
