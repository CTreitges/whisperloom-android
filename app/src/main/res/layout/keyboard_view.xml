<?xml version="1.0" encoding="utf-8"?>
<!-- Diktier-Tastatur (UX-Spec §5.3): Statuszeile · Pegelband · Mikro-Zone (88-dp-Taste mit
     Puls-Ring, Zustandsring und Sende-Bogen wie der Knopf) · Tastenreihe ohne Emoji. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/keyboard_bg"
    android:paddingHorizontal="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="12dp">

    <!-- Farbe je Zustand setzt der Service (onSurfaceVariant / recordingText / error / warning). -->
    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="24dp"
        android:gravity="center"
        android:accessibilityLiveRegion="polite"
        android:textColor="@color/loom_onSurfaceVariant"
        android:textSize="13sp"
        android:text="@string/kb_hint_hold" />

    <com.chris.whisperloom.ime.LevelBandView
        android:id="@+id/level"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginHorizontal="40dp"
        android:importantForAccessibility="no" />

    <FrameLayout
        android:id="@+id/mic_zone"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:clipChildren="false">

        <View
            android:id="@+id/mic_pulse"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_gravity="center"
            android:background="@drawable/bubble_pulse_ring"
            android:importantForAccessibility="no"
            android:visibility="invisible" />

        <View
            android:id="@+id/mic_ring"
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:layout_gravity="center"
            android:background="@drawable/bubble_ring_idle"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/mic_progress"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ime_progress_arc"
            android:visibility="gone" />

        <!-- Wisch-Ziele links/rechts (UX-Spec §5.3): waehrend des Ziehens nur Anzeige, nach dem
             Feststellen bedienbare Tasten. Symbol, Beschreibung und Bedienbarkeit setzt der
             Service; eingerastet = android:state_activated. -->
        <ImageButton
            android:id="@+id/gesture_discard"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="8dp"
            android:background="@drawable/gesture_target_discard"
            android:contentDescription="@string/cd_kb_discard"
            android:padding="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close"
            android:tint="@color/gesture_discard_tint"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/gesture_lock"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="8dp"
            android:background="@drawable/gesture_target_lock"
            android:contentDescription="@string/cd_kb_lock"
            android:padding="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_lock"
            android:tint="@color/gesture_lock_tint"
            android:visibility="gone" />

        <!-- 88 dp, Icon 36 dp (Padding 26). Fuellung = Level-List, Level = BubbleVisual.Fill.ordinal. -->
        <ImageButton
            android:id="@+id/mic"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center"
            android:background="@drawable/mic_button_bg"
            android:contentDescription="@string/cd_mic"
            android:padding="26dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_mic"
            android:tint="@color/loom_primary" />
    </FrameLayout>

    <!-- Tastenreihe 52 dp (Tasten 48, ab fontScale 1,3: 56/60 — ImeMetrics). Abstand 4 dp = 2 x margin 2. -->
    <LinearLayout
        android:id="@+id/key_row"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <ImageButton
            android:id="@+id/key_globe"
            style="@style/KeyIcon"
            android:contentDescription="@string/cd_kb_switch"
            android:src="@drawable/ic_language" />

        <Button
            android:id="@+id/key_comma"
            style="@style/Key"
            android:contentDescription="@string/cd_kb_comma"
            android:text="," />

        <Button
            android:id="@+id/key_space"
            style="@style/Key"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:contentDescription="@string/cd_kb_space"
            android:text="@string/kb_space"
            android:textColor="@color/loom_onSurfaceVariant"
            android:textSize="15sp" />

        <Button
            android:id="@+id/key_period"
            style="@style/Key"
            android:contentDescription="@string/cd_kb_period"
            android:text="." />

        <ImageButton
            android:id="@+id/key_backspace"
            style="@style/KeyIcon"
            android:contentDescription="@string/cd_kb_backspace"
            android:src="@drawable/ic_backspace" />

        <ImageButton
            android:id="@+id/key_enter"
            style="@style/KeyIcon"
            android:contentDescription="@string/cd_kb_enter"
            android:src="@drawable/ic_keyboard_return" />

        <ImageButton
            android:id="@+id/key_retry"
            style="@style/KeyIcon"
            android:contentDescription="@string/cd_kb_retry"
            android:src="@drawable/ic_replay"
            android:tint="@color/loom_error"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/key_settings"
            style="@style/KeyIcon"
            android:contentDescription="@string/cd_kb_settings"
            android:src="@drawable/ic_settings" />
    </LinearLayout>
</LinearLayout>
