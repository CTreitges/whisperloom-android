<?xml version="1.0" encoding="utf-8"?>
<!-- Sprachauftrag-Widget, Variante ICON (1x1 hochkant, Idealgroesse 40x40 dp): nur das Symbol,
     zentriert; die ganze Flaeche ist die Tippflaeche, TalkBack liest die contentDescription der
     Wurzel. Den Zustand zeigen Symbol und Hintergrund.
     Die Statuszeile ist unsichtbar, bleibt aber im Baum: VoiceTaskWidgetView befuellt jede
     Variante gleich, und ohne gemeldete Groesse (Launcher ohne Groessenliste, Robolectric) zeigt
     das System genau diese kleinste Variante — die Tests lesen den Status daran weiter ab. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp"
    android:background="@drawable/widget_bg_ready">

    <ImageView
        android:id="@+id/widget_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_mic"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/widget_photo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:importantForAccessibility="no" />
</FrameLayout>
