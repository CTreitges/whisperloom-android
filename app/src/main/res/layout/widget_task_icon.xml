<?xml version="1.0" encoding="utf-8"?>
<!-- Sprach-Command-Widget, Variante ICON (1x1 hochkant, Idealgroesse 40x58 dp): Kachel nur mit
     dem Symbol, darunter der Profilname wie bei einem App-Symbol. Die ganze Flaeche ist die
     Tippflaeche, TalkBack liest die contentDescription der Wurzel. Den Zustand zeigen Symbol und
     Hintergrund der Kachel. Aufbau wie STACK (durchsichtige Wurzel, Kachel, Name darunter).
     Die Statuszeile ist unsichtbar, bleibt aber im Baum: VoiceTaskWidgetView befuellt jede
     Variante gleich, und ohne gemeldete Groesse (Launcher ohne Groessenliste, Robolectric) zeigt
     das System genau diese kleinste Variante — die Tests lesen den Status daran weiter ab.
     Bemessen fuer 58 dp Hoehe: Kachel 4 + 32 + 4, dann 2 + Name (1 Zeile). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/widget_tile"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="4dp"
        android:background="@drawable/widget_bg_ready">

        <ImageView
            android:id="@+id/widget_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_mic"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/widget_photo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:visibility="gone"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <TextView
        android:id="@+id/widget_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="12sp"
        android:textColor="@color/loom_onSurface"
        android:shadowColor="@color/loom_labelShadow"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:text="@string/widget_label" />
</LinearLayout>
