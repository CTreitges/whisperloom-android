<?xml version="1.0" encoding="utf-8"?>
<!-- Rechtes Wisch-Ziel der Diktier-Tastatur: Aufnahme feststellen. Ruhe
     loom_surfaceContainerHigh, eingerastet loom_primaryContainer. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/key_ripple">
    <item>
        <selector>
            <item android:state_activated="true">
                <shape android:shape="oval">
                    <solid android:color="@color/loom_primaryContainer" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/loom_surfaceContainerHigh" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
