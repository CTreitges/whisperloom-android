<?xml version="1.0" encoding="utf-8"?>
<!-- Ausloeser des Schnellzugriffs in der Mikro-Zone: rund wie alles dort, Fuellung wie eine
     Taste. Geoeffnet = android:state_selected. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/key_ripple">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="oval">
                    <solid android:color="@color/loom_primaryContainer" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/loom_surfaceContainerHigh" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
