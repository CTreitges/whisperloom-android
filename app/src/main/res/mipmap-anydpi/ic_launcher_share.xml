<?xml version="1.0" encoding="utf-8"?>
<!-- Icon der ShareTranscribeActivity im Teilen-Menue (UX-Spec §4.2). Heisst ic_launcher_share,
     weil @drawable/ic_share bereits das Material-Symbol "share" ist. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_share_foreground" />
    <monochrome android:drawable="@drawable/ic_share_monochrome" />
</adaptive-icon>
