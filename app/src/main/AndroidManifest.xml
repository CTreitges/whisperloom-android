<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Modell-Download-Dienst (whisper.cpp-Modelle, 32-574 MB) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Nachfrage vor Downloads ueber mobile Daten (ConnectivityManager.isActiveNetworkMetered) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Mikrofon fuers Diktat, aber NICHT als Pflicht-Feature: die Funktion "Sprachnachricht teilen"
         (Datei-Transkription) braucht kein Mikrofon, so bleibt die App auch auf mikrofonlosen
         Geraeten (Chromebooks/manche Tablets) im Play Store installierbar. RECORD_AUDIO wird zur
         Laufzeit geprueft. Ohne diese Zeile wuerde RECORD_AUDIO android.hardware.microphone
         implizit als required=true werten und solche Geraete ausfiltern. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- allowBackup=false: die Einstellungen enthalten API-Keys im Klartext (shared_prefs/whisperloom.xml).
         Ohne Backup-Regeln landeten sie im Google-Auto-Backup und beim Geraetewechsel — die App
         verspricht "Dein Key bleibt auf dem Geraet". Modelle (32-574 MB) sind ohnehin zu gross fuers Backup. -->
    <application
        android:name=".WhisperLoomApplication"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Einzige Compose-Activity (UX-Spec §0.2): Router, Home, Assistent, Einstellungen.
             singleTask: Deep-Links aus IME/Overlay/Notification (AppNav) landen per onNewIntent. -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:launchMode="singleTask" />

        <!-- Launcher-Alias unter dem alten Namen: bestehende Startbildschirm-Verknuepfungen bleiben gueltig. -->
        <activity-alias
            android:name=".SetupActivity"
            android:targetActivity=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Einstellungen-Alias: Ziel von xml/method.xml (settingsActivity) und alten Intents.
             MainActivity erkennt den Alias am Komponentennamen und oeffnet den Einstellungen-Hub. -->
        <activity-alias
            android:name=".SettingsActivity"
            android:targetActivity=".ui.MainActivity"
            android:exported="true"
            android:label="@string/settings_title" />

        <activity
            android:name=".ShareTranscribeActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_share"
            android:label="@string/share_label"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <!-- Damit WhisperLoom im Teilen-Menü von WhatsApp & Co. auftaucht.
                 audio/* deckt Sprachnachrichten (ogg/opus), m4a, mp3 und amr ab;
                 application/ogg, weil manche Apps ogg so auszeichnen. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/ogg" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/ogg" />
            </intent-filter>
        </activity>

        <service
            android:name=".ime.WhisperLoomInputMethodService"
            android:exported="true"
            android:label="@string/ime_label"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <service
            android:name=".overlay.FloatingMicService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name=".whisper.ModelDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".a11y.TextInserterAccessibilityService"
            android:exported="true"
            android:label="@string/a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>
</manifest>
